{
  "name": "my-grades",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Keep variables set in the Cloudflare dashboard when GitHub deploys a new version.
  "keep_vars": true,

  // Cloudflare's hosted browser, used to sign in and read Skyward when you click "Pull from Skyward".
  "browser": { "binding": "BROWSER" },

  // Your grade page. Files in /public are served as-is; /api/pull goes to src/index.js.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Nothing is stored on Cloudflare: no passwords, no grades.
  "observability": { "enabled": false }
}
